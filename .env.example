# В бандл попадают только переменные с префиксом VUE_APP_: vite подставляет их
# через define, как раньше делал webpack.DefinePlugin. Префикс сохранён, потому
# что его читает и код пакетов @tager/*.
#
# NODE_ENV здесь не задаётся: vite выводит его из режима сборки
# (vite -> development, vite build -> production).

# Путь, по которому смонтирована админка
VUE_APP_PUBLIC_PATH=/admin

# Где запущено приложение: production | staging | development | local
VUE_APP_ENV=local

# Если пусто, API использует origin текущего окна
VUE_APP_API_URL=http://localhost:3500

# Постоянный токен — только для локальной разработки (VUE_APP_ENV=local).
# Приоритетнее значения из localStorage.
VUE_APP_ACCESS_TOKEN=

# Сайт, которым управляет эта админка
VUE_APP_WEBSITE_URL=https://project-name.dev.ozitag.com

# Sentry
VUE_APP_SENTRY_DSN=
VUE_APP_SENTRY_ENVIRONMENT=admin

# Sentry CLI (приватное, не коммитить реальные значения)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
